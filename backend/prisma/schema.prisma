generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  cashier
}

enum InvoiceStatus {
  completed
  cancelled
}

enum PaymentMethod {
  cash
  card
}

enum DiscountType {
  manual
  coupon
  category
  product
}

enum MovementType {
  purchase
  sale
  adjustment
  return
}

model User {
  id              Int         @id @default(autoincrement())
  username        String      @unique @db.VarChar(50)
  passwordHash    String      @map("password_hash") @db.VarChar(255)
  fullName        String      @map("full_name") @db.VarChar(100)
  role            UserRole    @default(cashier)
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  invoices              Invoice[]
  inventoryMovements    InventoryMovement[]
  cancelledInvoices    Invoice[]           @relation("CancelledBy")
  auditLogs            AuditLog[]

  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@map("categories")
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(150)
  barcode       String?   @unique @db.VarChar(50)
  categoryId    Int?      @map("category_id")
  costPrice     Decimal   @db.Decimal(10, 2) @map("cost_price")
  salePrice     Decimal   @db.Decimal(10, 2) @map("sale_price")
  stockQuantity Int       @default(0) @map("stock_quantity")
  minStock      Int       @default(0) @map("min_stock")
  imageUrl      String?   @map("image_url") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category          Category?        @relation(fields: [categoryId], references: [id])
  invoiceItems     InvoiceItem[]
  inventoryMovements InventoryMovement[]

  @@map("products")
}

model Invoice {
  id              Int          @id @default(autoincrement())
  invoiceNumber  String       @unique @map("invoice_number") @db.VarChar(20)
  userId          Int          @map("user_id")
  subtotal        Decimal      @db.Decimal(10, 2)
  discount       Decimal      @default(0) @db.Decimal(10, 2)
  tax             Decimal      @default(0) @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  status         InvoiceStatus @default(completed)
  notes          String?     @db.Text
  couponId       Int?        @map("coupon_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  cancelledAt    DateTime?   @map("cancelled_at")
  cancelledBy    Int?        @map("cancelled_by")

  user             User           @relation(fields: [userId], references: [id])
  coupon           Coupon?        @relation(fields: [couponId], references: [id])
  items            InvoiceItem[]
  discounts       InvoiceDiscount[]
  cancelledByUser User?          @relation("CancelledBy", fields: [cancelledBy], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id            Int       @id @default(autoincrement())
  invoiceId     Int       @map("invoice_id")
  productId     Int       @map("product_id")
  productName   String    @map("product_name") @db.VarChar(150)
  unitPrice     Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal   @map("line_total") @db.Decimal(10, 2)

  invoice  Invoice  @relation(fields: [invoiceId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@map("invoice_items")
}

model Coupon {
  id          Int        @id @default(autoincrement())
  code       String     @unique @db.VarChar(50)
  type       DiscountType
  value      Decimal    @db.Decimal(10, 2)
  minTotal   Decimal    @default(0) @map("min_total") @db.Decimal(10, 2)
  maxUses    Int?       @map("max_uses")
  usedCount  Int        @default(0) @map("used_count")
  startsAt   DateTime?  @map("starts_at")
  expiresAt  DateTime?  @map("expires_at")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")

  invoices  Invoice[]
  discounts InvoiceDiscount[]

  @@map("coupons")
}

model InvoiceDiscount {
  id          Int          @id @default(autoincrement())
  invoiceId  Int          @map("invoice_id")
  type       DiscountType
  couponId   Int?         @map("coupon_id")
  targetId   Int?         @map("target_id")
  amount     Decimal     @db.Decimal(10, 2)
  note       String?      @db.VarChar(255)

  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
  coupon    Coupon?      @relation(fields: [couponId], references: [id])

  @@map("invoice_discounts")
}

model InventoryMovement {
  id            Int          @id @default(autoincrement())
  productId     Int          @map("product_id")
  type          MovementType
  quantity     Int
  referenceId   Int?         @map("reference_id")
  userId        Int          @map("user_id")
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model Settings {
  id              Int       @id @default(autoincrement())
  shopName       String   @map("shop_name") @db.VarChar(150)
  shopAddress    String?  @map("shop_address") @db.VarChar(255)
  shopPhone      String?  @map("shop_phone") @db.VarChar(20)
  currency       String   @default("SYP") @db.VarChar(10)
  taxPercent     Decimal  @default(0) @map("tax_percent") @db.Decimal(5, 2)
  logoUrl        String?  @map("logo_url") @db.VarChar(255)
  invoiceFooter String?  @map("invoice_footer") @db.Text

  @@map("settings")
}

model AuditLog {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  action      String    @db.VarChar(50)
  entity      String?   @db.VarChar(50)
  entityId    Int?      @map("entity_id")
  details     String?   @db.Text @map("details")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User?     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}